<?xml version='1.0' encoding='utf-8'?>
<robot name="Motoman_GP180">
  <material name="MotomanBlue">
    <color rgba="0.12941 0.14902 0.74902 1"/>
  </material>
  <material name="MotomanBlack">
    <color rgba="0.094118 0.098039 0.101961 1"/>
  </material>

  <!-- link list -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/BaseLink.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/BaseLink.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/Link1.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/Link1.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/Link2.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/Link2.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/Link3.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/Link3.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/Link4.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/Link4.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/Link5.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/Link5.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Visual/glb/Link6.glb"/>
      </geometry>
      <material name="MotomanBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Collision/glb/Link6.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="ee_link"/>
  <!-- end of link list -->

  <!-- joint list(effort copy with GP180_120) -->
  <joint name="Joint1" type="revolute">
    <parent link="base_link"/>
    <child link="Link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.650"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="9414.38" velocity="2.181661"/>
  </joint>
  <joint name="Joint2" type="revolute">
    <parent link="Link1"/>
    <child link="Link2"/>
    <origin rpy="0 0 0" xyz="0.325 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.047197" upper="1.3264" effort="11645.4" velocity="2.0071286"/>
  </joint>
  <joint name="Joint3" type="revolute">
    <parent link="Link2"/>
    <child link="Link3"/>
    <origin rpy="0 0 0" xyz="0 0 1.15"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.500983" upper="1.570796" effort="7060.79" velocity="2.181661"/>
  </joint>
  <joint name="Joint4" type="revolute">
    <parent link="Link3"/>
    <child link="Link4"/>
    <origin rpy="0 0 0" xyz="0 0 0.3"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.283185" upper="6.283185" effort="1392.54" velocity="3.176499"/>
  </joint>
  <joint name="Joint5" type="revolute">
    <parent link="Link4"/>
    <child link="Link5"/>
    <origin rpy="0 0 0" xyz="1.225 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.2689280" upper="2.2689280" effort="1863.26" velocity="3.054326"/>
  </joint>
  <joint name="Joint6" type="revolute">
    <parent link="Link5"/>
    <child link="Link6"/>
    <origin rpy="0 0 0" xyz="0.225 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2831853" upper="6.2831853" effort="926.73" velocity="4.62512"/>
  </joint>
  <joint name="jointEE" type="fixed">
    <origin rpy="3.1415926 -1.570796 0" xyz="0 0 0"/>
    <parent link="Link6"/>
    <child link="ee_link"/>
  </joint>
  <!-- end of joint list -->

</robot>
