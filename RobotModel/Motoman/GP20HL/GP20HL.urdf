<?xml version='1.0' encoding='utf-8'?>
<robot name="Motoman_GP20HL">
  <material name="MotomanBlue">
    <color rgba="0.12941 0.14902 1 1"/>
  </material>
  <material name="MotomanBlack">
    <color rgba="0.094118 0.098039 0.101961 1"/>
  </material>

  <!-- link list -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/BaseLink.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/BaseLink.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link1">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/Link1.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/Link1.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link2">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/Link2.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/Link2.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link3">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/Link3.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/Link3.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link4">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/Link4.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/Link4.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link5">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/Link5.glb"/>
      </geometry>
      <material name="MotomanBlue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/Link5.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="Link6">
    <visual>
      <geometry>
        <mesh filename="Visual/glb/Link6.glb"/>
      </geometry>
      <material name="MotomanBlack"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/glb/Link6.glb"/>
      </geometry>
    </collision>
  </link>
  <link name="ee_link"/>
  <!-- end of link list -->

  <!-- joint list -->
  <joint name="Joint1" type="revolute">
    <parent link="base_link"/>
    <child link="Link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.540"/>
    <axis xyz="0 0 1"/>
    <limit effort="3087.0" lower="-3.1415" upper="3.1415" velocity="3.1415"/>
  </joint>
  <joint name="Joint2" type="revolute">
    <parent link="Link1"/>
    <child link="Link2"/>
    <origin rpy="0 0 0" xyz="0.145 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="3087.0" lower="-1.5708" upper="2.356" velocity="3.1415"/>
  </joint>
  <joint name="Joint3" type="revolute">
    <parent link="Link2"/>
    <child link="Link3"/>
    <origin rpy="0 0 0" xyz="0 0 1.150"/>
    <axis xyz="0 -1 0"/>
    <limit effort="926.1" lower="-1.39" upper="3.59" velocity="3.1415"/>
  </joint>
  <joint name="Joint4" type="revolute">
    <parent link="Link3"/>
    <child link="Link4"/>
    <origin rpy="0 0 0" xyz="1.812 0 0.250"/>
    <axis xyz="-1 0 0"/>
    <limit effort="39.2" lower="-3.4906" upper="3.4906" velocity="6.98"/>
  </joint>
  <joint name="Joint5" type="revolute">
    <parent link="Link4"/>
    <child link="Link5"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="39.2" lower="-2.6179" upper="2.6179" velocity="7.50"/>
  </joint>
  <joint name="Joint6" type="revolute">
    <parent link="Link5"/>
    <child link="Link6"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="39.2" lower="-7.9412" upper="7.9412" velocity="11.0"/>
  </joint>
  <joint name="jointEE" type="fixed">
    <origin rpy="3.1415926 -1.570796 0" xyz="0.100 0 0"/>
    <parent link="Link6"/>
    <child link="ee_link"/>
  </joint>
  <!-- end of joint list -->

</robot>
