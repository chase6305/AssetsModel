<?xml version="1.0" ?>
<robot name="Rokae_SR3">
  <!-- Constants for robot dimensions -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="Beige">
    <color rgba="1.0 0.784 0.5765 1.0"/>
  </material>
    
  <!--base-->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="Visual/BaseLink.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="Collision/BaseLink.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.167"/>
      <inertia ixx="31.16798700" ixy="-0.00064800" ixz="-0.00427300" iyy="30.71271000" iyz="-2.23655800" izz="5.87740200"/>
      <origin rpy="0 0 0" xyz="0.000011 -0.007992 0.235842"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="Link1"/>
    <limit effort="113" lower="-3.0543" upper="3.0543" velocity="18.0"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.328"/>
  </joint>
  <transmission name="tran1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint7">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor1">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  
  <!--link 1-->
  <link name="Link1">
    <visual>
      <geometry>
        <mesh filename="Visual/Link1.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
