    <inertial>
      <mass value="3.167"/>
      <inertia ixx="31.16798700" ixy="-0.00064800" ixz="-0.00427300" iyy="30.71271000" iyz="-2.23655800" izz="5.87740200"/>
      <origin rpy="0 0 0" xyz="0.000011 -0.007992 0.235842"/>
