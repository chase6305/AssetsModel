  <link name="ee_link"/>
  <!-- joints: main serial chain -->
  <joint name="Joint1" type="revolute">
    <origin xyz="0 0 0.333" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750" acceleration="15" jerk="7500"/>
  </joint>
  <joint name="Joint2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-1.7628" upper="1.7628" velocity="2.1750" acceleration="7.5" jerk="3750"/>
  </joint>
  <joint name="Joint3" type="revolute">
    <origin xyz="0 -0.316 0" rpy="1.5708 0 0"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750" acceleration="10" jerk="5000"/>
  </joint>
  <joint name="Joint4" type="revolute">
